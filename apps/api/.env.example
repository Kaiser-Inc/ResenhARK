# Copy to apps/api/.env for local dev. Production values live in the Render dashboard.
PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:4000
WEB_URL=http://localhost:4000
PUBLIC_API_URL=http://127.0.0.1:3333
REDIS_URL=redis://localhost:6379/0

# Required in production (SESSION_SECRET >= 32 chars, ADMIN_PASSWORD >= 12 chars).
# SESSION_SECRET=
# ADMIN_PASSWORD=

# spotify | fixture. Defaults to fixture in dev and spotify in production.
# With spotify, all three SPOTIFY_* below are required (boot fails otherwise).
# PLAYLIST_SOURCE=fixture
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3333/admin/spotify/callback

# real | fixture (fixture serves a silent mp3 instead of calling Deezer/iTunes).
# AUDIO_SOURCE=real

# Proxy hops in front of the API (Render: 1). Used for the client IP.
# TRUST_PROXY_HOPS=0

# Tests only (honored when NODE_ENV=test): seeds turn order and deck shuffle.
# E2E_SEED=
